{
    "name": "atellitech/auth-hyperf",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf"
    ],
    "description": "Auth module for Hyperf supporting SSO JWT verification and user synchronization.",
    "autoload": {
        "psr-4": {
            "AtelliTech\\Hyperf\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "tests"
        }
    },
    "require": {
        "php": ">=8.3",
        "firebase/php-jwt": "^7.0",
        "hyperf/cache": "~3.1.0",
        "hyperf/framework": "~3.1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0"
    },
    "suggest": {
        "swow/swow": "Required to create swow components."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit 1024M -l 0 ./src",
        "cs-fix": "php-cs-fixer fix $1",
        "codetest": "php-cs-fixer fix --verbose && phpstan"
    },
    "extra": {
        "hyperf": {
            "config": "AtelliTech\\Hyperf\\Auth\\ConfigProvider"
        },
        "branch-alias": {
            "dev-3.1": "3.1.x-dev"
        }
    }
}
